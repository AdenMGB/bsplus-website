{
  "name": "bsplus-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "cf:deploy": "pnpm build && wrangler deploy",
    "cf:dev": "node scripts/cf-dev.mjs",
    "db:migrate:local": "node scripts/d1-migrate-local.mjs",
    "db:migrate:remote": "node -e \"console.warn('[db:migrate:remote] Applies pending migrations to production D1 (bsplus-db). Ctrl+C to abort.')\" && pnpm exec wrangler d1 migrations apply bsplus-db --remote",
    "dev:seed": "pnpm --dir ../betterseqta-accounts db:seed:test-user",
    "cf:tail": "wrangler tail",
    "cf:deploy:dev": "pnpm build && wrangler deploy --env dev"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@nuxt/fonts": "0.11.1",
    "@nuxtjs/seo": "3.0.3",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@tiptap/extension-code-block": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "@zip.js/zip.js": "^2.23.0",
    "echarts": "^6.1.0",
    "gsap": "^3.15.0",
    "h3": "^1.15.11",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "markdown-it": "^14.3.2",
    "nuxt": "^3.21.11",
    "vue": "^3.5.44",
    "vue-echarts": "^8.3.2",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@types/markdown-it": "^14.2.0",
    "sass-embedded": "^1.105.1",
    "typescript": "^5.9.3",
    "vue-tsc": "^2.2.12",
    "wrangler": "^4.151.0"
  }
}