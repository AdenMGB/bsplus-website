# BetterSEQTA Plus (bsplus-website) — local development
# Copy to `.env` and `.env.local` as needed. `.env.local` is gitignored.

# --- Local service port map (wrangler dev) ---
# bsplus-website:     http://localhost:8787  (pnpm cf:dev)
# betterseqta-accounts: http://localhost:8788  (pnpm cf:dev)
# BetterSEQTA-Mail:   http://localhost:8789  (pnpm worker:dev)

# Auto-resolved by scripts/resolve-dev-services.mjs (written to .env.local)
# DEV_ACCOUNTS_URL=http://localhost:8788
# DEV_BSPLUS_URL=http://localhost:8787
# DEV_MAIL_URL=http://localhost:8789

# OAuth (register a dev client in local accounts admin)
NUXT_OAUTH_CLIENT_ID=
NUXT_OAUTH_CLIENT_SECRET=
NUXT_OAUTH_REDIRECT_URI=http://localhost:8787/api/auth/callback

# Accounts interop API (optional for admin analytics)
ACCOUNTS_API_KEY=

# Mail API (optional for feedback digests / survey campaigns)
BS_MAIL_API_KEY=
BS_MAIL_FROM=noreply@betterseqta.org
# BS_MAIL_API_URL=https://mail.internal.betterseqta.org
